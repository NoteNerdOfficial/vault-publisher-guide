# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
# What the plugin builds. Both are written inside the vault and neither is
# source: _site-preview/ is a preview build, _vault-publisher/ is the publish
# output and the review folder. The plugin never treats either as input, and
# neither should a repository.
_site-preview/
_vault-publisher/

# ---------------------------------------------------------------------------
# Obsidian
# ---------------------------------------------------------------------------
# The whole vault configuration folder stays local. It holds per-machine state
# (open panes, last selected file, caches), the installed plugin build, and
# plugin data.json files that can contain tokens, passwords and account names.
.obsidian/
.obsidian-mobile/
.trash/

